{
  "manifest_version": 3,
  "name": "Pattern Bridge",
  "version": "1.3.0",
  "description": "크롬 계열 브라우저(Chrome, Edge, Whale 등)의 탭 정보를 로컬 Pattern Bridge로 보내고, 개입 명령을 실행합니다",
  "key": "",
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pattern Bridge"
  }
}
