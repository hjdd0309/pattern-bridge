{
  "manifest_version": 3,
  "name": "Pattern Bridge",
  "version": "1.2.0",
  "description": "열려 있는 탭의 URL·제목과 탭 전환을 로컬 Pattern Bridge 서버로 전송합니다",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:7701/*",
    "http://127.0.0.1:7702/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pattern Bridge"
  }
}
