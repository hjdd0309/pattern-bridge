# OpenClaw Webhook 설정
OPENCLAW_WEBHOOK_URL=http://127.0.0.1:18789/hooks/agent
OPENCLAW_TOKEN=your-secret-token-here
# 웹훅 응답 대기 시간(ms). OpenClaw는 응답까지 5초 넘게 걸릴 수 있음 (기본값: 30000)
OPENCLAW_TIMEOUT_MS=30000

# 알림 채널: discord (OpenClaw에 해당 채널이 연결돼 있어야 함, telegram도 가능)
NOTIFY_CHANNEL=discord
# 수신자: 디스코드 채널 ID (본인 것으로 설정, 비어 있으면 웹훅 전송 안 함)
NOTIFY_TO=your-discord-channel-id

# (이전 방향) 패턴 스케줄러 주기. 지금은 스케줄러를 켜지 않아 쓰이지 않음 (기본값: 5분마다)
SCHEDULER_CRON=*/5 * * * *

# 크롬 확장 ↔ collector/guardian 연결 토큰 (아무 긴 무작위 문자열, 확장 팝업에도 같은 값 입력)
EXTENSION_TOKEN=your-extension-token

# 바른생활지킴이 MCP 서버 토큰 (아무 긴 무작위 문자열, OpenClaw mcp.servers 헤더에도 같은 값). 비우면 MCP 서버를 열지 않음
GUARDIAN_MCP_TOKEN=your-mcp-token
# OpenClaw Gateway 토큰 (openclaw.json의 gateway.auth.token). 규칙 실행을 /tools/invoke로 보낼 때 씀.
# 게이트웨이 운영자 권한이라 여기에만 둘 것. 비우면 OpenClaw를 거치지 않고 바로 직접 실행(fallback)
OPENCLAW_GATEWAY_TOKEN=
# (선택) Gateway 주소. 비우면 OPENCLAW_WEBHOOK_URL의 호스트를 씀
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# (선택) /tools/invoke 응답 대기(ms), 넘으면 직접 실행 (기본값: 5000)
# OPENCLAW_INVOKE_TIMEOUT_MS=5000
