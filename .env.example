# OpenClaw Webhook 설정
OPENCLAW_WEBHOOK_URL=http://127.0.0.1:18789/hooks/agent
OPENCLAW_TOKEN=your-secret-token-here
# 웹훅 응답 대기 시간(ms). OpenClaw는 응답까지 5초 넘게 걸릴 수 있음 (기본값: 30000)
OPENCLAW_TIMEOUT_MS=30000

# 알림 채널: discord (OpenClaw에 해당 채널이 연결돼 있어야 함, telegram도 가능)
NOTIFY_CHANNEL=discord
# 수신자: 디스코드 채널 ID (본인 것으로 설정, 비어 있으면 웹훅 전송 안 함)
NOTIFY_TO=your-discord-channel-id

# (이전 방향) 패턴 스케줄러 주기. 지금은 스케줄러를 켜지 않아 쓰이지 않음 (기본값: 5분마다)
SCHEDULER_CRON=*/5 * * * *

# 크롬 확장 ↔ collector/guardian 연결 토큰 (아무 긴 무작위 문자열, 확장 팝업에도 같은 값 입력)
EXTENSION_TOKEN=your-extension-token
