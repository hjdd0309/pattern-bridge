# OpenClaw Webhook 설정
OPENCLAW_WEBHOOK_URL=http://127.0.0.1:18789/hooks/agent
OPENCLAW_TOKEN=your-secret-token-here
# 웹훅 응답 대기 시간(ms). OpenClaw는 응답까지 5초 넘게 걸릴 수 있음 (기본값: 30000)
OPENCLAW_TIMEOUT_MS=30000

# 알림 채널: telegram 또는 discord (OpenClaw에 해당 채널이 연결돼 있어야 함)
NOTIFY_CHANNEL=telegram
# 수신자: 텔레그램 chat id 또는 디스코드 채널 ID (본인 것으로 설정, 비어 있으면 웹훅 전송 안 함)
NOTIFY_TO=your-chat-or-channel-id

# 스케줄러 설정 (기본값: 5분마다)
SCHEDULER_CRON=*/5 * * * *
